{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "fundamentos-contabilidad": {
      "root": ".",
      "entrypoint": "app.py",
      "buildCommand": "npm run build:web"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "fundamentos-contabilidad"
      }
    }
  ]
}
